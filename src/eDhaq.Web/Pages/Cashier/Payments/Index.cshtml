@page
@model eDhaq.Web.Pages.Cashier.Payments.IndexModel
@{
    ViewData["Title"] = "Cashier Payments";

    string FormatMoney(decimal amount) => "$" + amount.ToString("N2");
}

<h2 class="page-title mb-3">Cashier Payment Queue</h2>

<div class="card border-0 shadow-sm">
    <div class="card-body table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Order</th><th>Customer</th><th>Amount</th><th>Method</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var p in Model.Payments)
            {
                <tr>
                    <td>@p.Order.OrderNumber</td>
                    <td>@p.Order.Customer.User.FirstName @p.Order.Customer.User.LastName</td>
                    <td>@FormatMoney(p.Amount)</td>
                    <td>@p.Method</td>
                    <td>@p.Status</td>
                    <td>
                        <form method="post" asp-page-handler="Process" class="d-flex gap-2">
                            <input type="hidden" name="PaymentId" value="@p.Id" />
                            <select name="Method" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<eDhaq.Models.Enums.PaymentMethod>()"></select>
                            <select name="Status" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<eDhaq.Models.Enums.PaymentStatus>()"></select>
                            <button class="btn btn-sm btn-edhaq" type="submit">Process</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
