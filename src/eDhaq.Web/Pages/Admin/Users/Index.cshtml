@page
@model eDhaq.Web.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "User Management";

    var roleColors = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["Administrator"]  = "danger",
        ["Manager"]        = "warning",
        ["Cashier"]        = "info",
        ["LaundryStaff"]   = "primary",
        ["PickupDriver"]   = "success",
        ["DeliveryDriver"] = "success",
        ["Customer"]       = "secondary"
    };

    string RoleBadge(string role)
    {
        var color = roleColors.TryGetValue(role, out var c) ? c : "secondary";
        return $"<span class=\"badge text-bg-{color} fw-semibold\">{role}</span>";
    }
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="page-title mb-1">User Management</h2>
        <p class="text-muted mb-0" style="font-size:.9rem">@Model.TotalCount user(s) registered</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#changePasswordModal">
            <i class="bi bi-key me-1"></i> Change My Password
        </button>
        <button class="btn btn-edhaq d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#createUserModal">
            <i class="bi bi-person-plus-fill"></i> Create User
        </button>
    </div>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center justify-content-between">
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#createUserModal" data-newrole="Customer">
                <i class="bi bi-person-plus"></i> Add Customer
            </button>
            <button type="button" class="btn btn-outline-success btn-sm" data-bs-toggle="modal" data-bs-target="#createUserModal" data-newrole="PickupDriver">
                <i class="bi bi-truck"></i> Add Driver
            </button>
            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createUserModal" data-newrole="LaundryStaff">
                <i class="bi bi-person-badge"></i> Add Laundry Staff
            </button>
        </div>
        <div class="small text-muted">Use edit and delete icons on each row to update or remove customers, drivers, and staff.</div>
    </div>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-sm @(string.IsNullOrWhiteSpace(Model.RoleFilter) ? "btn-dark" : "btn-outline-dark")" asp-page="./Index" asp-route-Search="@Model.Search">All</a>
    <a class="btn btn-sm @(Model.RoleFilter == "Customer" ? "btn-secondary" : "btn-outline-secondary")" asp-page="./Index" asp-route-Search="@Model.Search" asp-route-RoleFilter="Customer">Customers</a>
    <a class="btn btn-sm @((Model.RoleFilter == "PickupDriver" || Model.RoleFilter == "DeliveryDriver") ? "btn-success" : "btn-outline-success")" asp-page="./Index" asp-route-Search="@Model.Search" asp-route-RoleFilter="PickupDriver">Drivers</a>
    <a class="btn btn-sm @(Model.RoleFilter == "LaundryStaff" ? "btn-primary" : "btn-outline-primary")" asp-page="./Index" asp-route-Search="@Model.Search" asp-route-RoleFilter="LaundryStaff">Laundry Staff</a>
</div>

<!-- Search -->
<form method="get" class="mb-3 d-flex gap-2" style="max-width:420px">
    <input type="text" name="Search" value="@Model.Search" class="form-control" placeholder="Search by name or email…" />
    <input type="hidden" name="RoleFilter" value="@Model.RoleFilter" />
    <button class="btn btn-outline-secondary px-3" type="submit"><i class="bi bi-search"></i></button>
    @if (!string.IsNullOrWhiteSpace(Model.Search))
    {
        <a class="btn btn-outline-danger px-3" asp-page="./Index" asp-route-RoleFilter="@Model.RoleFilter"><i class="bi bi-x-lg"></i></a>
    }
</form>

<!-- Users Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Roles</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td class="fw-semibold">@(string.IsNullOrWhiteSpace(user.FullName) ? "—" : user.FullName)</td>
                    <td class="text-muted">@user.Email</td>
                    <td>
                        @if (user.CurrentRoles.Count == 0)
                        {
                            <span class="text-muted fst-italic">No role</span>
                        }
                        else
                        {
                            @foreach (var r in user.CurrentRoles)
                            {
                                @Html.Raw(RoleBadge(r))
                                <text> </text>
                            }
                        }
                    </td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge text-bg-success"><i class="bi bi-check-circle"></i> Active</span>
                        }
                        else
                        {
                            <span class="badge text-bg-danger"><i class="bi bi-x-circle"></i> Inactive</span>
                        }
                    </td>
                    <td class="text-muted" style="font-size:.85rem">@user.CreatedAt.ToString("dd MMM yyyy")</td>
                    <td class="text-end">
                        <div class="d-flex gap-1 justify-content-end">
                            <button class="btn btn-sm btn-outline-primary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editUserModal"
                                    data-userid="@user.UserId"
                                    data-firstname="@user.FirstName"
                                    data-lastname="@user.LastName"
                                    data-email="@user.Email"
                                    data-phone="@user.PhoneNumber"
                                    data-alternatephone="@user.AlternatePhone"
                                    data-licenseplate="@user.LicensePlate"
                                    data-vehiclemodel="@user.VehicleModel"
                                    data-position="@user.Position"
                                    data-roles="@string.Join(",", user.CurrentRoles)">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <!-- Edit Roles -->
                            <button class="btn btn-sm btn-outline-secondary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editRolesModal"
                                    data-userid="@user.UserId"
                                    data-fullname="@user.FullName"
                                    data-email="@user.Email"
                                    data-roles="@string.Join(",", user.CurrentRoles)">
                                <i class="bi bi-person-gear"></i>
                            </button>
                            <!-- Reset Password -->
                            <button class="btn btn-sm btn-outline-warning"
                                    data-bs-toggle="modal"
                                    data-bs-target="#resetPasswordModal"
                                    data-userid="@user.UserId"
                                    data-email="@user.Email"
                                    title="Reset Password">
                                <i class="bi bi-key"></i>
                            </button>
                            <!-- Toggle Active -->
                            <form method="post" asp-page-handler="ToggleActive">
                                <input type="hidden" name="UserId" value="@user.UserId" />
                                <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                        title="@(user.IsActive ? "Deactivate" : "Activate")">
                                    <i class="bi @(user.IsActive ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                </button>
                            </form>
                            <!-- Delete -->
                            <button class="btn btn-sm btn-outline-danger"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteModal"
                                    data-userid="@user.UserId"
                                    data-email="@user.Email">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Users.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-4">No users found.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

<!-- Pagination -->
@{
    var totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
}
@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination">
            @for (var p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == Model.PageNumber ? "active" : null)">
                    <a class="page-link" asp-page="./Index" asp-route-PageNumber="@p" asp-route-Search="@Model.Search" asp-route-RoleFilter="@Model.RoleFilter">@p</a>
                </li>
            }
        </ul>
    </nav>
}

<!-- ════════════════════════════════════════════
     CHANGE PASSWORD MODAL (own account)
═════════════════════════════════════════════ -->
<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <form method="post" asp-page-handler="ChangePassword">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="changePasswordModalLabel">
                        <i class="bi bi-key text-warning me-2"></i>Change My Password
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Current Password <span class="text-danger">*</span></label>
                        <input name="ChangePwdCurrent" type="password" class="form-control" placeholder="Enter current password" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">New Password <span class="text-danger">*</span></label>
                        <input name="ChangePwdNew" type="password" class="form-control" placeholder="Min. 8 characters" required minlength="8" maxlength="100" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label fw-semibold">Confirm New Password <span class="text-danger">*</span></label>
                        <input name="ChangePwdConfirm" type="password" class="form-control" placeholder="Re-enter new password" required minlength="8" maxlength="100" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-edhaq"><i class="bi bi-check2 me-1"></i> Update Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ════════════════════════════════════════════
     RESET PASSWORD MODAL (another user)
═════════════════════════════════════════════ -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <form method="post" asp-page-handler="ResetPassword">
                <input type="hidden" name="UserId" id="resetPwdUserId" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="resetPasswordModalLabel">
                        <i class="bi bi-key-fill text-danger me-2"></i>Reset User Password
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted mb-3">Resetting password for <strong id="resetPwdUserEmail"></strong></p>
                    <div class="mb-0">
                        <label class="form-label fw-semibold">New Password <span class="text-danger">*</span></label>
                        <input name="NewPassword" type="password" class="form-control" placeholder="Min. 8 characters" required minlength="8" maxlength="100" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-edhaq"><i class="bi bi-check2 me-1"></i> Reset Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ════════════════════════════════════════════
     CREATE USER MODAL
═════════════════════════════════════════════ -->
<div class="modal fade" id="createUserModal" tabindex="-1" aria-labelledby="createUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <form method="post" asp-page-handler="CreateUser">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="createUserModalLabel">
                        <i class="bi bi-person-plus-fill text-danger me-2"></i>Create New User
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">First Name <span class="text-danger">*</span></label>
                            <input name="NewFirstName" type="text" class="form-control" placeholder="Abdi" required maxlength="100" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Last Name <span class="text-danger">*</span></label>
                            <input name="NewLastName" type="text" class="form-control" placeholder="Hassan" required maxlength="100" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                            <input name="NewEmail" type="email" class="form-control" placeholder="user@edhaq.com" required maxlength="256" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Password <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input name="NewPassword" type="password" class="form-control" placeholder="Min. 8 characters" id="newPwdInput" required minlength="8" maxlength="100" />
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePwd()">
                                    <i class="bi bi-eye" id="pwdEyeIcon"></i>
                                </button>
                            </div>
                            <div class="form-text">Must include uppercase, lowercase, number &amp; symbol.</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Role <span class="text-danger">*</span></label>
                            <select name="NewRole" id="newRoleSelect" class="form-select" required onchange="onRoleChange(this.value)">
                                <option value="">— Select a role —</option>
                                @foreach (var role in Model.Roles)
                                {
                                    <option value="@role">@role</option>
                                }
                            </select>
                        </div>

                        <!-- Phone (all roles) -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">Phone Number</label>
                            <input name="NewPhone" type="tel" class="form-control" placeholder="+252 6x xxx xxxx" maxlength="20" />
                        </div>

                        <!-- Driver fields -->
                        <div id="driverFields" style="display:none" class="col-12">
                            <div class="p-3 rounded border bg-light">
                                <div class="fw-semibold mb-2 text-primary"><i class="bi bi-truck me-1"></i>Driver Details</div>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label class="form-label small">License Plate</label>
                                        <input name="NewLicensePlate" type="text" class="form-control form-control-sm" placeholder="e.g. SO-1234" maxlength="20" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small">Vehicle Model</label>
                                        <input name="NewVehicleModel" type="text" class="form-control form-control-sm" placeholder="e.g. Toyota Hiace" maxlength="50" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Staff position field -->
                        <div id="staffFields" style="display:none" class="col-12">
                            <div class="p-3 rounded border bg-light">
                                <div class="fw-semibold mb-2 text-primary"><i class="bi bi-person-badge me-1"></i>Staff Details</div>
                                <label class="form-label small">Position / Job Title</label>
                                <input name="NewPosition" type="text" class="form-control form-control-sm" placeholder="e.g. Senior Laundry Operator" maxlength="50" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-edhaq">
                        <i class="bi bi-check2-circle me-1"></i> Create User
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ════════════════════════════════════════════
     EDIT USER MODAL
═════════════════════════════════════════════ -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <form method="post" asp-page-handler="UpdateUser">
                <input type="hidden" name="EditUserId" id="editProfileUserId" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="editUserModalLabel">
                        <i class="bi bi-pencil-square text-primary me-2"></i>Edit User
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3 text-muted" id="editProfileRoleSummary" style="font-size:.9rem"></p>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">First Name <span class="text-danger">*</span></label>
                            <input name="EditFirstName" id="editProfileFirstName" type="text" class="form-control" required maxlength="100" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Last Name <span class="text-danger">*</span></label>
                            <input name="EditLastName" id="editProfileLastName" type="text" class="form-control" required maxlength="100" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                            <input name="EditEmail" id="editProfileEmail" type="email" class="form-control" required maxlength="256" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Phone Number</label>
                            <input name="EditPhone" id="editProfilePhone" type="tel" class="form-control" maxlength="20" />
                        </div>
                        <div id="editCustomerFields" style="display:none" class="col-12">
                            <div class="p-3 rounded border bg-light">
                                <div class="fw-semibold mb-2 text-primary"><i class="bi bi-person me-1"></i>Customer Details</div>
                                <label class="form-label small">Alternate Phone</label>
                                <input name="EditAlternatePhone" id="editProfileAlternatePhone" type="text" class="form-control form-control-sm" maxlength="100" />
                            </div>
                        </div>
                        <div id="editDriverFields" style="display:none" class="col-12">
                            <div class="p-3 rounded border bg-light">
                                <div class="fw-semibold mb-2 text-primary"><i class="bi bi-truck me-1"></i>Driver Details</div>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label class="form-label small">License Plate</label>
                                        <input name="EditLicensePlate" id="editProfileLicensePlate" type="text" class="form-control form-control-sm" maxlength="20" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small">Vehicle Model</label>
                                        <input name="EditVehicleModel" id="editProfileVehicleModel" type="text" class="form-control form-control-sm" maxlength="50" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div id="editStaffFields" style="display:none" class="col-12">
                            <div class="p-3 rounded border bg-light">
                                <div class="fw-semibold mb-2 text-primary"><i class="bi bi-person-badge me-1"></i>Staff Details</div>
                                <label class="form-label small">Position / Job Title</label>
                                <input name="EditPosition" id="editProfilePosition" type="text" class="form-control form-control-sm" maxlength="50" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check2 me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ════════════════════════════════════════════
     EDIT ROLES MODAL
═════════════════════════════════════════════ -->
<div class="modal fade" id="editRolesModal" tabindex="-1" aria-labelledby="editRolesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <form method="post" asp-page-handler="AssignRole">
                <input type="hidden" name="UserId" id="editUserId" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="editRolesModalLabel">
                        <i class="bi bi-person-gear text-primary me-2"></i>Edit Permissions
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3 text-muted" id="editUserEmail" style="font-size:.9rem"></p>
                    <div class="d-flex flex-column gap-2" id="editRolesContainer">
                        @foreach (var role in Model.Roles)
                        {
                            <label class="d-flex align-items-center gap-2 p-2 border rounded cursor-pointer role-checkbox-label">
                                <input class="form-check-input mt-0 role-edit-cb" type="checkbox" name="SelectedRoles" value="@role" />
                                <span class="fw-semibold">@role</span>
                                <span class="ms-auto badge text-bg-@(roleColors.TryGetValue(role, out var bc) ? bc : "secondary")">@role</span>
                            </label>
                        }
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check2 me-1"></i> Save Permissions
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ════════════════════════════════════════════
     DELETE CONFIRM MODAL
═════════════════════════════════════════════ -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg">
            <form method="post" asp-page-handler="DeleteUser">
                <input type="hidden" name="UserId" id="deleteUserId" />
                <div class="modal-body text-center py-4">
                    <div class="text-danger mb-3" style="font-size:2.5rem"><i class="bi bi-exclamation-triangle-fill"></i></div>
                    <h5 class="fw-bold mb-1">Delete User?</h5>
                    <p class="text-muted mb-0" id="deleteUserEmail" style="font-size:.9rem"></p>
                    <p class="text-muted mt-1" style="font-size:.82rem">This action cannot be undone.</p>
                </div>
                <div class="modal-footer border-0 pt-0 justify-content-center gap-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash3 me-1"></i> Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function updateEditSections(currentRoles) {
        var hasCustomer = currentRoles.includes('Customer');
        var hasDriver = currentRoles.includes('PickupDriver') || currentRoles.includes('DeliveryDriver');
        var hasStaff = currentRoles.includes('LaundryStaff') || currentRoles.includes('Cashier') || currentRoles.includes('Manager');

        document.getElementById('editCustomerFields').style.display = hasCustomer ? '' : 'none';
        document.getElementById('editDriverFields').style.display = hasDriver ? '' : 'none';
        document.getElementById('editStaffFields').style.display = hasStaff ? '' : 'none';
    }

    document.getElementById('editUserModal').addEventListener('show.bs.modal', function(e) {
        var btn = e.relatedTarget;
        var currentRoles = btn.dataset.roles ? btn.dataset.roles.split(',').filter(Boolean) : [];

        document.getElementById('editProfileUserId').value = btn.dataset.userid;
        document.getElementById('editProfileFirstName').value = btn.dataset.firstname || '';
        document.getElementById('editProfileLastName').value = btn.dataset.lastname || '';
        document.getElementById('editProfileEmail').value = btn.dataset.email || '';
        document.getElementById('editProfilePhone').value = btn.dataset.phone || '';
        document.getElementById('editProfileAlternatePhone').value = btn.dataset.alternatephone || '';
        document.getElementById('editProfileLicensePlate').value = btn.dataset.licenseplate || '';
        document.getElementById('editProfileVehicleModel').value = btn.dataset.vehiclemodel || '';
        document.getElementById('editProfilePosition').value = btn.dataset.position || '';
        document.getElementById('editProfileRoleSummary').textContent = currentRoles.length > 0
            ? 'Current roles: ' + currentRoles.join(', ')
            : 'Current roles: none assigned';

        updateEditSections(currentRoles);
    });

    document.getElementById('createUserModal').addEventListener('show.bs.modal', function(e) {
        var btn = e.relatedTarget;
        if (!btn) return;

        var preferredRole = btn.dataset.newrole;
        if (!preferredRole) return;

        var roleSelect = document.getElementById('newRoleSelect');
        if (!roleSelect) return;

        roleSelect.value = preferredRole;
        onRoleChange(preferredRole);
    });

    // Edit Roles modal — populate fields
    document.getElementById('editRolesModal').addEventListener('show.bs.modal', function(e) {
        var btn = e.relatedTarget;
        document.getElementById('editUserId').value = btn.dataset.userid;
        document.getElementById('editUserEmail').textContent = btn.dataset.email + ' — ' + btn.dataset.fullname;

        var currentRoles = btn.dataset.roles ? btn.dataset.roles.split(',') : [];
        document.querySelectorAll('.role-edit-cb').forEach(function(cb) {
            cb.checked = currentRoles.includes(cb.value);
        });
    });

    // Delete modal — populate fields
    document.getElementById('deleteModal').addEventListener('show.bs.modal', function(e) {
        var btn = e.relatedTarget;
        document.getElementById('deleteUserId').value = btn.dataset.userid;
        document.getElementById('deleteUserEmail').textContent = btn.dataset.email;
    });

    // Toggle password visibility
    function togglePwd() {
        var inp = document.getElementById('newPwdInput');
        var icon = document.getElementById('pwdEyeIcon');
        if (inp.type === 'password') {
            inp.type = 'text';
            icon.className = 'bi bi-eye-slash';
        } else {
            inp.type = 'password';
            icon.className = 'bi bi-eye';
        }
    }

    // Show/hide role-specific fields
    var driverRoles = ['PickupDriver', 'DeliveryDriver'];
    var staffRoles  = ['LaundryStaff', 'Cashier', 'Manager'];

    function onRoleChange(role) {
        document.getElementById('driverFields').style.display = driverRoles.includes(role) ? '' : 'none';
        document.getElementById('staffFields').style.display  = staffRoles.includes(role)  ? '' : 'none';
    }

    // Reset password modal (per-row)
    document.getElementById('resetPasswordModal').addEventListener('show.bs.modal', function(e) {
        var btn = e.relatedTarget;
        document.getElementById('resetPwdUserId').value = btn.dataset.userid;
        document.getElementById('resetPwdUserEmail').textContent = btn.dataset.email;
    });
</script>
}

