@page
@model eDhaq.Web.Pages.Admin.Drivers.IndexModel
@using eDhaq.Models.Enums
@{
    ViewData["Title"] = "Drivers";
    string StatusBadge(DriverStatus s) => s switch
    {
        DriverStatus.Available => "success",
        DriverStatus.OnDuty => "primary",
        _ => "secondary"
    };
    string FormatMoney(decimal amount) => "$" + amount.ToString("N2");
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="page-title mb-1">Drivers</h2>
        <p class="text-muted mb-0" style="font-size:.9rem">@Model.TotalDrivers driver(s)</p>
    </div>
    <a class="btn btn-edhaq d-flex align-items-center gap-2" asp-page="/Admin/Users/Index">
        <i class="bi bi-person-plus-fill"></i> Add Driver
    </a>
</div>

<!-- Summary cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card stat-primary"><div class="stat-icon"><i class="bi bi-truck"></i></div><div class="stat-body"><span class="stat-label">Total Drivers</span><h4 class="stat-value">@Model.TotalDrivers</h4></div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card stat-success"><div class="stat-icon"><i class="bi bi-check-circle"></i></div><div class="stat-body"><span class="stat-label">Available Now</span><h4 class="stat-value">@Model.AvailableDrivers</h4></div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card stat-blue"><div class="stat-icon"><i class="bi bi-box-seam"></i></div><div class="stat-body"><span class="stat-label">Completed Deliveries</span><h4 class="stat-value">@Model.TotalDeliveries</h4></div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card stat-warning"><div class="stat-icon"><i class="bi bi-cash-stack"></i></div><div class="stat-body"><span class="stat-label">Total Earnings</span><h4 class="stat-value">@FormatMoney(Model.TotalEarnings)</h4></div></div>
    </div>
</div>

<!-- Search -->
<form method="get" class="mb-3">
    <div class="input-group" style="max-width:480px">
        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
        <input type="text" name="q" value="@Model.SearchTerm" class="form-control" placeholder="Search by name, email or plate..." />
        <button type="submit" class="btn btn-edhaq">Search</button>
        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
        {
            <a class="btn btn-outline-secondary" asp-page="./Index" title="Clear"><i class="bi bi-x-lg"></i></a>
        }
    </div>
</form>

<!-- Drivers table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Driver</th>
                    <th>Vehicle</th>
                    <th>Status</th>
                    <th>Active Jobs</th>
                    <th>Completed</th>
                    <th>Rating</th>
                    <th>Earnings</th>
                    <th class="text-end">Details</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var d in Model.Drivers)
            {
                <tr>
                    <td>
                        <div class="fw-semibold">@d.FullName</div>
                        <div class="text-muted small">@d.Email</div>
                        @if (!string.IsNullOrEmpty(d.Phone))
                        {
                            <div class="text-muted small"><i class="bi bi-telephone"></i> @d.Phone</div>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(d.VehicleModel) || !string.IsNullOrEmpty(d.LicensePlate))
                        {
                            <div class="small">@d.VehicleModel</div>
                            <div class="text-muted small">@d.LicensePlate</div>
                        }
                        else
                        {
                            <span class="text-muted small">—</span>
                        }
                    </td>
                    <td>
                        <span class="badge text-bg-@StatusBadge(d.Status)">@d.Status</span>
                        @if (!d.IsActive)
                        {
                            <span class="badge text-bg-danger">Disabled</span>
                        }
                    </td>
                    <td><span class="badge text-bg-primary">@d.ActiveAssignments</span></td>
                    <td><span class="badge text-bg-success">@d.CompletedDeliveries</span></td>
                    <td>
                        <span class="text-warning">@for (var i = 0; i < (int)Math.Round(d.Rating); i++) { <i class="bi bi-star-fill"></i> }</span>
                        <span class="small text-muted">@d.Rating.ToString("0.0")</span>
                    </td>
                    <td class="fw-semibold">@FormatMoney(d.TotalEarnings)</td>
                    <td class="text-end">
                        <div class="d-flex gap-1 justify-content-end">
                            <a class="btn btn-sm btn-outline-primary" asp-page="./Details" asp-route-id="@d.DriverId" title="View details">
                                <i class="bi bi-eye"></i>
                            </a>
                            <form method="post" asp-page-handler="ToggleAvailability" asp-route-id="@d.DriverId">
                                <button type="submit" class="btn btn-sm @(d.IsAvailable ? "btn-outline-success" : "btn-outline-secondary")" title="@(d.IsAvailable ? "Mark offline" : "Mark available")">
                                    <i class="bi @(d.IsAvailable ? "bi-broadcast" : "bi-broadcast-pin")"></i>
                                </button>
                            </form>
                            <form method="post" asp-page-handler="ToggleActive" asp-route-userId="@d.UserId">
                                <button type="submit" class="btn btn-sm @(d.IsActive ? "btn-outline-warning" : "btn-outline-success")" title="@(d.IsActive ? "Deactivate" : "Activate")">
                                    <i class="bi @(d.IsActive ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                </button>
                            </form>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@d.DriverId" onsubmit="return confirm('Delete driver @d.FullName? This cannot be undone.');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Drivers.Count == 0)
            {
                <tr><td colspan="8" class="text-center text-muted py-4">No drivers found.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
