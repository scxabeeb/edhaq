@page
@model eDhaq.Web.Pages.Admin.Payments.IndexModel
@{
    ViewData["Title"] = "Payments";

    string FormatMoney(decimal amount) => "$" + amount.ToString("N2");
}

<h2 class="page-title mb-3">Payments Overview</h2>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-3"><select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<eDhaq.Models.Enums.PaymentStatus>()"><option value="">All Statuses</option></select></div>
            <div class="col-md-3"><input asp-for="From" type="date" class="form-control" /></div>
            <div class="col-md-3"><input asp-for="To" type="date" class="form-control" /></div>
            <div class="col-md-3"><button class="btn btn-outline-dark w-100" type="submit">Filter</button></div>
        </form>
    </div>
</div>

@{
    var totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
}

@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination">
            @for (var p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == Model.PageNumber ? "active" : null)">
                    <a class="page-link" asp-page="./Index" asp-route-PageNumber="@p" asp-route-Status="@Model.Status" asp-route-From="@Model.From" asp-route-To="@Model.To">@p</a>
                </li>
            }
        </ul>
    </nav>
}

<div class="card border-0 shadow-sm">
    <div class="card-body table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr><th>Order</th><th>Customer</th><th>Method</th><th>Status</th><th>Amount</th><th>Action</th></tr>
            </thead>
            <tbody>
            @foreach (var p in Model.Payments)
            {
                <tr>
                    <td>@p.Order.OrderNumber</td>
                    <td>@p.Order.Customer.User.FirstName @p.Order.Customer.User.LastName</td>
                    <td>@p.Method</td>
                    <td>@p.Status</td>
                    <td>@FormatMoney(p.Amount)</td>
                    <td>
                        <form method="post" asp-page-handler="UpdateStatus" class="d-flex gap-2">
                            <input type="hidden" name="PaymentId" value="@p.Id" />
                            <select name="NewStatus" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<eDhaq.Models.Enums.PaymentStatus>()"></select>
                            <input type="text" name="Note" class="form-control form-control-sm" placeholder="Note" />
                            <button class="btn btn-sm btn-edhaq" type="submit">Save</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
