@using eDhaq.Models.Entities
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav flex-row align-items-center gap-2 auth-actions">
@if (SignInManager.IsSignedIn(User))
{
    var name = User.Identity?.Name ?? "Account";
    <li class="nav-item d-none d-sm-block">
        <a class="user-chip" asp-page="/Auth/Profile" title="Manage profile">
            <span class="sidebar-user-avatar">@char.ToUpperInvariant(name[0])</span>
            <span class="text-truncate" style="max-width:180px">@name</span>
        </a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-page="/Auth/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
            <button type="submit" class="btn btn-sm btn-outline-dark"><i class="bi bi-box-arrow-right"></i><span class="d-none d-sm-inline ms-1">Sign out</span></button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="btn btn-sm btn-outline-dark" asp-page="/Auth/Login">Sign in</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-sm btn-edhaq" asp-page="/Auth/Register">Get started</a>
    </li>
}
</ul>
