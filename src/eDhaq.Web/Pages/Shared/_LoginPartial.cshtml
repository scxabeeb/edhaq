@using eDhaq.Models.Entities
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center gap-2 auth-actions">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link fw-semibold text-dark" asp-page="/Auth/Profile" title="Manage">@User.Identity?.Name</a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-page="/Auth/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
            <button type="submit" class="btn btn-sm btn-outline-dark">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="btn btn-sm btn-outline-dark" asp-page="/Auth/Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-sm btn-edhaq" asp-page="/Auth/Login">Login</a>
    </li>
}
</ul>
