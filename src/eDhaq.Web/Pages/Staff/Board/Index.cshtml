@page
@model eDhaq.Web.Pages.Staff.Board.IndexModel
@using eDhaq.Models.Enums
@{
    ViewData["Title"] = "Laundry Board";

    string ColumnColor(OrderStatus s) => s switch
    {
        OrderStatus.LaundryReceived => "#64748B",
        OrderStatus.Sorting => "#78716C",
        OrderStatus.Washing => "#9333EA",
        OrderStatus.DryCleaning => "#A855F7",
        OrderStatus.Drying => "#C026D3",
        OrderStatus.Ironing => "#DB2777",
        OrderStatus.Folding => "#EC4899",
        OrderStatus.Packaging => "#F472B6",
        OrderStatus.ReadyForDelivery => "#14A44D",
        _ => "#6B7280"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="page-title mb-1">Laundry Workflow Board</h2>
        <p class="text-muted mb-0 small">Track orders through the pipeline. Click "Next" to advance each order.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-dark btn-sm" asp-page="/Staff/Orders/Placed">Placed Orders</a>
        <a class="btn btn-edhaq btn-sm" asp-page="/Staff/Orders/Process">Intake & Processing</a>
    </div>
</div>

<div class="board-grid">
    @foreach (var col in Model.Board)
    {
        var color = ColumnColor(col.Key);
        <div class="board-col">
            <div class="board-col-header" style="border-top: 3px solid @color;">
                <span class="fw-semibold small">@col.Key</span>
                <span class="badge rounded-pill" style="background:@color;color:#fff;">@col.Value.Count</span>
            </div>
            <div class="board-col-body">
                @if (col.Value.Count == 0)
                {
                    <div class="text-muted small text-center py-2 empty-col">No orders</div>
                }
                @foreach (var order in col.Value)
                {
                    <div class="board-card">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-semibold small order-num">@order.OrderNumber</span>
                            <span class="badge bg-success bg-opacity-10 text-success fw-semibold small">$@order.TotalAmount.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-muted text-truncate customer-name" title="@order.Customer.User.FirstName @order.Customer.User.LastName">
                                <i class="bi bi-person-circle me-1"></i>@order.Customer.User.FirstName @order.Customer.User.LastName
                            </small>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <button class="btn btn-link btn-sm p-0 text-muted item-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#boardItems-@order.Id" aria-expanded="false" title="Show @order.Items.Count items">
                                <i class="bi bi-bag"></i> @order.Items.Count
                            </button>
                            @if (col.Key == OrderStatus.ReadyForDelivery)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success small">Ready</span>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="MoveNext" class="d-inline">
                                    <input type="hidden" name="OrderId" value="@order.Id" />
                                    <input type="hidden" name="CurrentStatus" value="@order.Status" />
                                    <button class="btn btn-sm btn-edhaq px-2 py-0" type="submit" title="Move to next stage">
                                        Next <i class="bi bi-arrow-right"></i>
                                    </button>
                                </form>
                            }
                        </div>
                        <div class="collapse mt-1" id="boardItems-@order.Id">
                            <ul class="list-unstyled mb-0 tiny-list">
                                @foreach (var item in order.Items)
                                {
                                    <li>
                                        <span class="text-truncate item-name">@item.Service?.Name</span>
                                        <span class="text-muted">x@item.Quantity</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .board-grid {
        display: grid;
        grid-template-columns: repeat(9, 1fr);
        gap: .5rem;
        align-items: start;
    }
    .board-col {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: .5rem;
        overflow: hidden;
        min-width: 0;
    }
    .board-col-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: .4rem .5rem;
        background: #fff;
        border-bottom: 1px solid #e9ecef;
    }
    .board-col-body {
        padding: .35rem;
        min-height: 80px;
    }
    .empty-col { padding: .5rem 0; }
    .board-card {
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: .35rem;
        padding: .4rem .45rem;
        margin-bottom: .3rem;
        box-shadow: 0 1px 2px rgba(16,24,40,.04);
        transition: box-shadow .15s, transform .15s;
    }
    .board-card:hover {
        box-shadow: 0 2px 6px rgba(16,24,40,.1);
        transform: translateY(-1px);
    }
    .order-num { font-size: .78rem; }
    .customer-name { max-width: 100%; font-size: .72rem; }
    .item-toggle { font-size: .7rem; line-height: 1; text-decoration: none; }
    .tiny-list { font-size: .7rem; border-top: 1px dashed #e9ecef; padding-top: .2rem; margin-top: .2rem; }
    .tiny-list li { display: flex; justify-content: space-between; gap: .25rem; line-height: 1.3; }
    .item-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    @@media (max-width: 1400px) {
        .board-grid { grid-template-columns: repeat(5, 1fr); }
    }
    @@media (max-width: 900px) {
        .board-grid { grid-template-columns: repeat(3, 1fr); }
    }
</style>
