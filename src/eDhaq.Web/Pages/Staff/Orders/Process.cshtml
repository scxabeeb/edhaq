@page
@model eDhaq.Web.Pages.Staff.Orders.ProcessModel
@using eDhaq.Models.Enums
@using eDhaq.Models.Entities
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = "Staff - Order Processing";

    string StageBadge(OrderStatus s) => s switch
    {
        OrderStatus.OrderPlaced or OrderStatus.PickupScheduled or OrderStatus.DriverAssigned or OrderStatus.DriverOnTheWay or OrderStatus.ClothesPickedUp => "text-bg-primary",
        OrderStatus.LaundryReceived or OrderStatus.Sorting => "text-bg-secondary",
        OrderStatus.Washing or OrderStatus.DryCleaning or OrderStatus.Drying or OrderStatus.Ironing or OrderStatus.Folding or OrderStatus.Packaging => "text-bg-dark",
        OrderStatus.ReadyForDelivery => "text-bg-success",
        OrderStatus.OutForDelivery or OrderStatus.Delivered or OrderStatus.Completed => "text-bg-info",
        _ => "text-bg-light"
    };
}

@functions {
    private static string BadgeForDriverStatus(DriverJobAction s) => s switch
    {
        DriverJobAction.Pending => "text-bg-warning",
        DriverJobAction.Accepted => "text-bg-info",
        DriverJobAction.Completed => "text-bg-success",
        DriverJobAction.Rejected => "text-bg-danger",
        _ => "text-bg-secondary"
    };

    IHtmlContent WriteDriverTask(DriverAssignment? a, string label, Order order)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append("<div class=\"d-flex justify-content-between align-items-center mb-1\">");
        sb.Append($"<span class=\"fw-semibold small\">{label}</span>");
        if (a is not null)
        {
            sb.Append($"<span class=\"badge {BadgeForDriverStatus(a.Status)}\">{a.Status}</span>");
        }
        sb.Append("</div>");

        if (a is null)
        {
            sb.Append("<div class=\"text-muted small\">Not assigned yet.</div>");
            return new HtmlString(sb.ToString());
        }

        var driverName = a.Driver?.User is not null
            ? System.Net.WebUtility.HtmlEncode($"{a.Driver.User.FirstName} {a.Driver.User.LastName}")
            : "Driver";
        sb.Append($"<div class=\"small\">{driverName}</div>");
        sb.Append("<ul class=\"list-unstyled mb-0 mt-1 small\">");

        sb.Append($"<li class=\"{(a.Status >= DriverJobAction.Pending ? "text-success" : "text-muted")}\">");
        sb.Append($"<i class=\"bi bi-{(a.Status >= DriverJobAction.Pending ? "check-circle" : "circle")} me-1\"></i>Assigned &middot; {a.AssignedAt:g}</li>");

        sb.Append($"<li class=\"{(a.Status >= DriverJobAction.Accepted ? "text-success" : "text-muted")}\">");
        sb.Append($"<i class=\"bi bi-{(a.Status >= DriverJobAction.Accepted ? "check-circle" : "circle")} me-1\"></i>Accepted");
        if (a.AcceptedAt.HasValue) sb.Append($" &middot; {a.AcceptedAt.Value:g}");
        sb.Append("</li>");

        sb.Append($"<li class=\"{(a.Status >= DriverJobAction.Completed ? "text-success" : "text-muted")}\">");
        sb.Append($"<i class=\"bi bi-{(a.Status >= DriverJobAction.Completed ? "check-circle" : "circle")} me-1\"></i>Completed");
        if (a.CompletedAt.HasValue) sb.Append($" &middot; {a.CompletedAt.Value:g}");
        sb.Append("</li>");

        if (a.Status == DriverJobAction.Rejected)
        {
            sb.Append("<li class=\"text-danger\"><i class=\"bi bi-x-circle me-1\"></i>Rejected</li>");
        }

        sb.Append("</ul>");

        if (label == "Pickup" && order.PickupActualAt.HasValue)
        {
            sb.Append($"<div class=\"small text-muted mt-1\">Picked up at {order.PickupActualAt.Value:g}</div>");
        }
        if (label == "Delivery" && order.DeliveryActualAt.HasValue)
        {
            sb.Append($"<div class=\"small text-muted mt-1\">Delivered at {order.DeliveryActualAt.Value:g}</div>");
        }
        if (label == "Delivery" && !string.IsNullOrWhiteSpace(a.DeliveryPhotoUrl))
        {
            sb.Append($"<a class=\"small mt-1 d-inline-block\" href=\"{a.DeliveryPhotoUrl}\" target=\"_blank\"><i class=\"bi bi-image me-1\"></i>View delivery proof</a>");
        }

        return new HtmlString(sb.ToString());
    }
}
}

<h2 class="page-title mb-3">Customer Orders Intake & Processing</h2>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-6">
                <input asp-for="Search" class="form-control" placeholder="Search order/customer/email" />
            </div>
            <div class="col-md-3">
                <select asp-for="StatusFilter" class="form-select" asp-items="Html.GetEnumSelectList<eDhaq.Models.Enums.OrderStatus>()">
                    <option value="">All Stages</option>
                </select>
            </div>
            <div class="col-md-3 d-grid">
                <button class="btn btn-outline-dark" type="submit">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form id="bulkAdvanceForm" method="post" asp-page-handler="BulkAdvance" class="row g-2 mb-3">
            <input type="hidden" name="Search" value="@Model.Search" />
            <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
            <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
            <div class="col-md-7">
                <small class="text-muted">Select orders and move each to its next valid stage.</small>
            </div>
            <div class="col-md-3 d-grid ms-auto">
                <button class="btn btn-sm btn-outline-dark" type="submit">Bulk Update</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                <tr>
                    <th>
                        <input type="checkbox" id="selectAllOrders" />
                    </th>
                    <th>Order</th>
                    <th>Customer</th>
                    <th>Current Stage</th>
                    <th>Pickup Schedule</th>
                    <th>Driver Assignment</th>
                    <th>Service</th>
                    <th>Set Stage</th>
                    <th>Next Stage</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td>
                            <button class="btn btn-sm btn-outline-dark" type="button" data-bs-toggle="collapse" data-bs-target="#orderDetail-@order.Id" aria-expanded="false" title="Show order items & driver tasks">
                                <i class="bi bi-list-check"></i>
                            </button>
                            <div class="mt-1">
                                <input type="checkbox"
                                       name="SelectedOrderIds"
                                       value="@order.Id"
                                       form="bulkAdvanceForm"
                                       class="order-select" />
                            </div>
                        </td>
                        <td>
                            <input type="checkbox"
                                   name="SelectedOrderIds"
                                   value="@order.Id"
                                   form="bulkAdvanceForm"
                                   class="order-select" />
                        </td>
                        <td>@order.OrderNumber</td>
                        <td>@order.Customer.User.FirstName @order.Customer.User.LastName</td>
                        <td>
                            <span class="badge @StageBadge(order.Status)">@order.Status</span>
                            <div class="small text-muted mt-1">
                                <span class="text-uppercase" style="font-size:.7rem; letter-spacing:.04em;">@Model.StagePhase(order.Status) Phase</span>
                            </div>
                        </td>
                        <td>
                            <form method="post" asp-page-handler="SchedulePickup" class="d-flex gap-2 align-items-center">
                                <input type="hidden" name="OrderId" value="@order.Id" />
                                <input type="hidden" name="Search" value="@Model.Search" />
                                <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                                <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                                <input type="datetime-local"
                                       name="PickupScheduledAt"
                                       value="@(order.PickupScheduledAt.Year < 2000 ? string.Empty : order.PickupScheduledAt.ToString("yyyy-MM-ddTHH:mm"))"
                                       class="form-control form-control-sm"
                                       style="min-width: 180px;" />
                                <button class="btn btn-sm btn-outline-primary" type="submit">Set</button>
                            </form>
                        </td>
                        <td>
                            @if (Model.CanAssignPickup(order.Status) || Model.CanAssignDelivery(order.Status))
                            {
                                var assigningPickup = Model.CanAssignPickup(order.Status);
                                var currentAssignment = assigningPickup ? Model.GetPickupAssignment(order) : Model.GetDeliveryAssignment(order);
                                <form method="post" asp-page-handler="AssignDriver" class="d-flex gap-2">
                                    <input type="hidden" name="OrderId" value="@order.Id" />
                                    <input type="hidden" name="Search" value="@Model.Search" />
                                    <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                                    <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                                    <select name="DriverId" class="form-select form-select-sm" style="min-width: 220px;">
                                        <option value="">@(assigningPickup ? "Select Pickup Driver" : "Select Delivery Driver")</option>
                                        @foreach (var driver in Model.DriverOptions)
                                        {
                                            var selectedDriverId = currentAssignment?.DriverId;
                                            if (selectedDriverId?.ToString() == driver.Value)
                                            {
                                                <option value="@driver.Value" selected>@driver.Text</option>
                                            }
                                            else
                                            {
                                                <option value="@driver.Value">@driver.Text</option>
                                            }
                                        }
                                    </select>
                                    @if (assigningPickup)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" type="submit" name="isPickup" value="true">Assign Pickup</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-success" type="submit" name="isPickup" value="false">Assign Delivery</button>
                                    }
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">@Model.StagePhase(order.Status) stage - driver assignment not available yet.</span>
                            }
                            @{
                                var pickupAssignment = Model.GetPickupAssignment(order);
                                var deliveryAssignment = Model.GetDeliveryAssignment(order);
                            }
                            <div class="small text-muted mt-1">
                                <div>Pickup: @(pickupAssignment?.Driver?.User is null ? "Not assigned" : $"{pickupAssignment.Driver.User.FirstName} {pickupAssignment.Driver.User.LastName}")</div>
                                <div>Delivery: @(deliveryAssignment?.Driver?.User is null ? "Not assigned" : $"{deliveryAssignment.Driver.User.FirstName} {deliveryAssignment.Driver.User.LastName}")</div>
                            </div>
                        </td>
                        <td>
                            <form method="post" asp-page-handler="AssignService" class="d-flex gap-2">
                                <input type="hidden" name="OrderId" value="@order.Id" />
                                <input type="hidden" name="Search" value="@Model.Search" />
                                <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                                <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                                <select name="ServiceId" class="form-select form-select-sm" style="min-width: 230px;">
                                    @foreach (var service in Model.ServiceOptions)
                                    {
                                        var selectedServiceId = order.Items.FirstOrDefault()?.ServiceId;
                                        if (selectedServiceId?.ToString() == service.Value)
                                        {
                                            <option value="@service.Value" selected>@service.Text</option>
                                        }
                                        else
                                        {
                                            <option value="@service.Value">@service.Text</option>
                                        }
                                    }
                                </select>
                                <button class="btn btn-sm btn-outline-primary" type="submit">Set</button>
                            </form>
                        </td>
                        <td>
                            <form method="post" asp-page-handler="SetProcessingStage" class="d-flex gap-2">
                                <input type="hidden" name="OrderId" value="@order.Id" />
                                <input type="hidden" name="Search" value="@Model.Search" />
                                <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                                <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                                <select name="ProcessingStatus" class="form-select form-select-sm" style="min-width: 180px;">
                                    @foreach (var stage in Model.ProcessingStageOptions)
                                    {
                                        if (stage.Value == order.Status.ToString())
                                        {
                                            <option value="@stage.Value" selected>@stage.Text</option>
                                        }
                                        else
                                        {
                                            <option value="@stage.Value">@stage.Text</option>
                                        }
                                    }
                                </select>
                                <button class="btn btn-sm btn-outline-secondary" type="submit">Set</button>
                            </form>
                        </td>
                        <td>
                            @if (Model.GetNextStage(order.Status) is eDhaq.Models.Enums.OrderStatus nextStage)
                            {
                                <form method="post" asp-page-handler="Advance" class="d-flex gap-2 align-items-center">
                                    <input type="hidden" name="OrderId" value="@order.Id" />
                                    <input type="hidden" name="Search" value="@Model.Search" />
                                    <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                                    <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                                    <span class="small text-muted">@nextStage</span>
                                    <button class="btn btn-sm btn-edhaq" type="submit">Advance</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">No next stage</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td colspan="9" class="p-0 border-0">
                            <div class="collapse" id="orderDetail-@order.Id">
                                <div class="p-3 bg-light border rounded-3">
                                    <h6 class="fw-semibold mb-2">Order @order.OrderNumber &mdash; Items <span class="text-muted fw-normal">(@order.Items.Count)</span></h6>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered align-middle mb-3">
                                            <thead class="table-light">
                                                <tr><th>Service</th><th class="text-center" style="width:70px;">Qty</th><th class="text-end" style="width:90px;">Unit</th><th class="text-end" style="width:90px;">Total</th><th>Notes</th></tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in order.Items)
                                                {
                                                    <tr>
                                                        <td>@item.Service?.Name</td>
                                                        <td class="text-center">@item.Quantity</td>
                                                        <td class="text-end">@item.UnitPrice.ToString("N2")</td>
                                                        <td class="text-end">@item.TotalPrice.ToString("N2")</td>
                                                        <td class="text-muted">@item.Notes</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <h6 class="fw-semibold mb-2">Driver Tasks</h6>
                                    <div class="row g-2">
                                        <div class="col-md-6"><div class="border rounded p-2 h-100">@WriteDriverTask(Model.GetPickupAssignment(order), "Pickup", order)</div></div>
                                        <div class="col-md-6"><div class="border rounded p-2 h-100">@WriteDriverTask(Model.GetDeliveryAssignment(order), "Delivery", order)</div></div>
                                    </div>
                                    <div class="mt-2 d-flex justify-content-between small text-muted">
                                        <span>Subtotal: $@order.SubTotal.ToString("N2") &middot; Delivery: $@order.DeliveryFee.ToString("N2") &middot; Discount: $@order.Discount.ToString("N2")</span>
                                        <span class="fw-semibold text-dark">Total: $@order.TotalAmount.ToString("N2")</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(order.SpecialInstructions))
                                    {
                                        <div class="mt-1 small"><span class="fw-semibold">Instructions:</span> @order.SpecialInstructions</div>
                                    }
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@{
    var totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
}

@section Scripts {
<script>
(() => {
    const selectAll = document.getElementById('selectAllOrders');
    const checkboxes = document.querySelectorAll('.order-select');
    if (!selectAll || checkboxes.length === 0) return;

    selectAll.addEventListener('change', () => {
        checkboxes.forEach(cb => cb.checked = selectAll.checked);
    });
})();
</script>
}

@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination">
            @for (var p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == Model.PageNumber ? "active" : null)">
                    <a class="page-link"
                       asp-page="./Process"
                       asp-route-PageNumber="@p"
                       asp-route-Search="@Model.Search"
                       asp-route-StatusFilter="@Model.StatusFilter">@p</a>
                </li>
            }
        </ul>
    </nav>
}
