@page
@model eDhaq.Web.Pages.Customer.Orders.InvoiceModel
@{
    ViewData["Title"] = "Invoice";

    string FormatMoney(decimal amount) => "$" + amount.ToString("N2");
}

@if (Model.Order is null)
{
    <div class="alert alert-danger">Order not found.</div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body" id="invoicePrint">
            <div class="d-flex justify-content-between mb-3">
                <div>
                    <h3 class="mb-1">Invoice</h3>
                    <div class="text-muted">Order: @Model.Order.OrderNumber</div>
                </div>
                <div class="text-end">
                    <img src="~/images/logo.svg" alt="e-Dhaq" style="height:42px;" />
                    <div class="small text-muted">@DateTime.UtcNow.ToString("dd MMM yyyy")</div>
                </div>
            </div>
            <table class="table table-sm">
                <thead><tr><th>Service</th><th>Qty</th><th>Unit</th><th>Total</th></tr></thead>
                <tbody>
                @foreach (var item in Model.Order.Items)
                {
                    <tr>
                        <td>@item.Service.Name</td>
                        <td>@item.Quantity</td>
                        <td>@FormatMoney(item.UnitPrice)</td>
                        <td>@FormatMoney(item.TotalPrice)</td>
                    </tr>
                }
                </tbody>
            </table>
            <div class="text-end">
                <div>Subtotal: <strong>@FormatMoney(Model.Order.SubTotal)</strong></div>
                @if (Model.Order.DeliveryFee > 0)
                {
                    <div>Delivery: <strong>@FormatMoney(Model.Order.DeliveryFee)</strong></div>
                }
                <div>Discount: <strong>@FormatMoney(Model.Order.Discount)</strong></div>
                <div class="fs-5">Total: <strong>@FormatMoney(Model.Order.TotalAmount)</strong></div>
            </div>
        </div>
        <div class="card-footer bg-white border-0 text-end">
            <button onclick="window.print()" class="btn btn-edhaq">Print</button>
        </div>
    </div>
}
