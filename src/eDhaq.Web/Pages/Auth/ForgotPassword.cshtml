@page
@model eDhaq.Web.Pages.Auth.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-icon"><i class="bi bi-envelope-paper"></i></div>
        <h2 class="auth-title">Forgot your password?</h2>
        <p class="auth-subtitle">Enter the email you signed up with (e.g. your Gmail). We'll email you a 6-digit code to reset it.</p>

        <form method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
            <div class="mb-4">
                <label asp-for="Input.Email" class="form-label"></label>
                <div class="input-icon">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Input.Email" class="form-control" type="email" placeholder="you@gmail.com" autocomplete="email" autofocus />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>
            <button class="btn btn-edhaq btn-lg w-100" type="submit">Send reset code</button>
        </form>

        <div class="auth-footer">
            <a asp-page="ResetPassword" asp-route-email="@Model.Input.Email">I already have a code</a>
            <a asp-page="Login"><i class="bi bi-arrow-left"></i> Back to sign in</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
