@page
@model eDhaq.Web.Pages.Auth.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="text-center mb-3">
                    <img src="~/images/logo.svg" alt="e-Dhaq" style="height:70px; width:70px; object-fit:contain;" />
                </div>
                <h3 class="mb-3">Forgot Password</h3>
                <form method="post">
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label"></label>
                        <input asp-for="Input.Email" class="form-control" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <button class="btn btn-edhaq w-100" type="submit">Generate Reset Token</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
