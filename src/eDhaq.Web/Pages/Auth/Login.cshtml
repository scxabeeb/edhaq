@page
@model eDhaq.Web.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="auth-wrap">
    <div class="auth-card">
        <img src="~/images/logo.png" alt="e-Dhaq" class="auth-logo" />
        <h2 class="auth-title">Welcome back</h2>
        <p class="auth-subtitle">Sign in to manage your laundry orders.</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <div class="input-icon">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Input.Email" class="form-control" type="email" placeholder="you@gmail.com" autocomplete="email" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>
            <div class="mb-2">
                <div class="d-flex justify-content-between align-items-baseline">
                    <label asp-for="Input.Password" class="form-label"></label>
                    <a asp-page="ForgotPassword" class="small fw-semibold">Forgot password?</a>
                </div>
                <div class="input-icon">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                </div>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>
            <div class="form-check mb-4">
                <input asp-for="Input.RememberMe" class="form-check-input" />
                <label asp-for="Input.RememberMe" class="form-check-label"></label>
            </div>
            <button class="btn btn-edhaq btn-lg w-100" type="submit">Sign in</button>
        </form>

        <div class="auth-footer justify-content-center">
            <span class="text-muted">New to e-Dhaq?</span>
            <a asp-page="Register" class="fw-semibold">Create an account</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
