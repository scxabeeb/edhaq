@page
@model eDhaq.Web.Pages.Auth.ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="text-center mb-3">
                    <img src="~/images/logo.svg" alt="e-Dhaq" style="height:70px; width:70px; object-fit:contain;" />
                </div>
                <h3 class="mb-3">Reset Password</h3>
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                    <div class="mb-2">
                        <label asp-for="Input.Email" class="form-label"></label>
                        <input asp-for="Input.Email" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label asp-for="Input.Token" class="form-label"></label>
                        <input asp-for="Input.Token" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label asp-for="Input.Password" class="form-label"></label>
                        <input asp-for="Input.Password" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" />
                    </div>
                    <button class="btn btn-edhaq w-100" type="submit">Reset Password</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
