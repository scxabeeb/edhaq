@page
@model eDhaq.Web.Pages.Auth.ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-icon"><i class="bi bi-shield-lock"></i></div>
        <h2 class="auth-title">Reset your password</h2>
        <p class="auth-subtitle">Enter the 6-digit code we emailed you and choose a new password.</p>

        <form method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <div class="input-icon">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Input.Email" class="form-control" type="email" placeholder="you@gmail.com" autocomplete="email" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Code" class="form-label"></label>
                <input asp-for="Input.Code" class="form-control code-input" inputmode="numeric" maxlength="6" placeholder="••••••" autocomplete="one-time-code" autofocus />
                <span asp-validation-for="Input.Code" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <div class="input-icon">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
                </div>
                <div class="form-text">At least 8 characters with upper &amp; lower case, a number and a symbol.</div>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <div class="input-icon">
                    <i class="bi bi-lock-fill"></i>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>
            <button class="btn btn-edhaq btn-lg w-100" type="submit">Reset password</button>
        </form>

        <div class="auth-footer">
            <a asp-page="ForgotPassword" asp-route-email="@Model.Input.Email">Didn't get a code? Resend</a>
            <a asp-page="Login"><i class="bi bi-arrow-left"></i> Back to sign in</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
