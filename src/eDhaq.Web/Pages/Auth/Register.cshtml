@page
@model eDhaq.Web.Pages.Auth.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="text-center mb-3">
                    <img src="~/images/logo.svg" alt="e-Dhaq" style="height:70px; width:70px; object-fit:contain;" />
                </div>
                <h3 class="mb-3">Create Account</h3>
                <form method="post" class="row g-3">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="col-md-6">
                        <label asp-for="Input.FirstName" class="form-label"></label>
                        <input asp-for="Input.FirstName" class="form-control" />
                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.LastName" class="form-label"></label>
                        <input asp-for="Input.LastName" class="form-control" />
                        <span asp-validation-for="Input.LastName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.Email" class="form-label"></label>
                        <input asp-for="Input.Email" class="form-control" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.PhoneNumber" class="form-label"></label>
                        <input asp-for="Input.PhoneNumber" class="form-control" />
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.CityId" class="form-label">City</label>
                        <select asp-for="Input.CityId" asp-items="Model.CityOptions" class="form-select" id="citySelect"></select>
                        <span asp-validation-for="Input.CityId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.VillageId" class="form-label">Village</label>
                        <select asp-for="Input.VillageId" asp-items="Model.VillageOptions" class="form-select" id="villageSelect"></select>
                        <span asp-validation-for="Input.VillageId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.SubVillageId" class="form-label">Sub Village</label>
                        <select asp-for="Input.SubVillageId" asp-items="Model.SubVillageOptions" class="form-select" id="subVillageSelect">
                            <option value="">Select sub village (optional)</option>
                        </select>
                        <span asp-validation-for="Input.SubVillageId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.Street" class="form-label">Street / Landmark</label>
                        <input asp-for="Input.Street" class="form-control" />
                        <span asp-validation-for="Input.Street" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.Password" class="form-label"></label>
                        <input asp-for="Input.Password" class="form-control" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <button class="btn btn-edhaq w-100" type="submit">Create Account</button>
                    </div>
                </form>
                <div class="mt-3 text-center">
                    <a asp-page="Login">Already have an account? Sign in</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const citySelect = document.getElementById('citySelect');
            const villageSelect = document.getElementById('villageSelect');
            const subVillageSelect = document.getElementById('subVillageSelect');

            if (!citySelect || !villageSelect || !subVillageSelect) {
                return;
            }

            const fillSelect = (select, items, includeOptional) => {
                const current = select.value;
                select.innerHTML = '';
                if (includeOptional) {
                    const empty = document.createElement('option');
                    empty.value = '';
                    empty.textContent = 'Select sub village (optional)';
                    select.appendChild(empty);
                }

                items.forEach(item => {
                    const opt = document.createElement('option');
                    opt.value = item.id;
                    opt.textContent = item.name;
                    select.appendChild(opt);
                });

                if (current && [...select.options].some(o => o.value === current)) {
                    select.value = current;
                }
            };

            const loadVillages = async () => {
                const cityId = citySelect.value;
                if (!cityId) {
                    fillSelect(villageSelect, [], false);
                    fillSelect(subVillageSelect, [], true);
                    return;
                }

                const res = await fetch(`?handler=Villages&cityId=${cityId}`);
                const villages = await res.json();
                fillSelect(villageSelect, villages, false);
                await loadSubVillages();
            };

            const loadSubVillages = async () => {
                const villageId = villageSelect.value;
                if (!villageId) {
                    fillSelect(subVillageSelect, [], true);
                    return;
                }

                const res = await fetch(`?handler=SubVillages&villageId=${villageId}`);
                const subs = await res.json();
                fillSelect(subVillageSelect, subs, true);
            };

            citySelect.addEventListener('change', loadVillages);
            villageSelect.addEventListener('change', loadSubVillages);
        })();
    </script>
}
